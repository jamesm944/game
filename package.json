{
  "name": "ageofwind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden:record": "vitest run -t 'golden' --update",
    "replay:to-fixture": "tsx tools/replay-to-fixture.ts",
    "bake:villager": "tsx tools/atlas-bake/index.ts --units villager",
    "bake:units": "tsx tools/atlas-bake/index.ts --all"
  },
  "dependencies": {
    "bitecs": "^0.4.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
