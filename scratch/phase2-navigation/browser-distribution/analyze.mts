import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";
import type { BenchmarkResult } from "../../full-game-movement/harness/types";
import {
  aggregateApplyTicks,
  distribution,
  individualRepaths,
  initialGroupApplyTotal,
  initialLeaders,
  leaderTimings,
  responseMs,
} from "./metrics.mts";

const ROOT = path.dirname(fileURLToPath(import.meta.url));
const RESULTS = path.join(ROOT, "results");

interface BrowserRun {
  readonly browser: string;
  readonly browserVersion: string;
  readonly capturedAt: string;
  readonly host: unknown;
  readonly userAgent: string;
  readonly navigatorPlatform: string;
  readonly hardwareConcurrency: number;
  readonly config: {
    readonly candidate: string;
    readonly scenario: string;
    readonly population: number;
    readonly ticks: number;
    readonly warmupRuns: number;
    readonly measuredRuns: number;
  };
  readonly samples: readonly BenchmarkResult[];
}

const runs: BrowserRun[] = [];
for (let sampleNumber = 1; sampleNumber <= 5; sampleNumber += 1) {
  const file = `chrome-mixed-p1000-t3600-sample-${String(sampleNumber).padStart(2, "0")}.json`;
  const run = JSON.parse(await readFile(path.join(RESULTS, file), "utf8")) as BrowserRun;
  const expected = {
    candidate: "astar",
    scenario: "mixed-destinations-120",
    population: 1000,
    ticks: 3600,
    warmupRuns: 1,
    measuredRuns: 1,
  };
  if (JSON.stringify(run.config) !== JSON.stringify(expected)) throw new Error(`${file}: unexpected config`);
  if (run.browser !== "chrome" || run.samples.length !== 1) throw new Error(`${file}: invalid browser sample`);
  const sample = run.samples[0]!;
  if (sample.finalTick !== 3600 || initialLeaders(sample).length !== 8) {
    throw new Error(`${file}: incomplete trace or incorrect initial leader count`);
  }
  runs.push(run);
}

const applyTickRows = runs.flatMap((run, index) => aggregateApplyTicks(index + 1, run.samples[0]!));
const samples = runs.map((run, index) => {
  const sample = run.samples[0]!;
  const leaders = initialLeaders(sample);
  const repaths = individualRepaths(sample);
  const applyRows = applyTickRows.filter((row) => row.sample === index + 1);
  return {
    sample: index + 1,
    file: `chrome-mixed-p1000-t3600-sample-${String(index + 1).padStart(2, "0")}.json`,
    capturedAt: run.capturedAt,
    wallClockMs: sample.wallClockMs,
    frames: sample.frames,
    blockedFrames: sample.scheduler.blockedTicks,
    finalQueueDepth: sample.scheduler.finalQueueDepth,
    meanQueueDepth: sample.scheduler.meanQueueDepth,
    maxQueueDepth: sample.scheduler.maxQueueDepth,
    requests: sample.pathRequests.length,
    repaths: sample.movementDiagnostics.repaths,
    completed: sample.completions.filter((unit) => unit.outcome === "completed").length,
    activeAtCutoff: sample.completions.filter((unit) => unit.outcome === "active-at-cutoff").length,
    crowdStates: sample.crowdStates,
    snapshotBytes: sample.pathRequests.reduce((sum, request) => sum + request.snapshotBytes, 0),
    finalFullStateHash: sample.finalFullStateHash,
    initialLeaderResponse: distribution(leaders.map(responseMs)),
    initialLeaderTimings: leaderTimings(sample),
    individualRepathResponse: distribution(repaths.map(responseMs)),
    initialGroupApplyTick: leaders[0]!.applyTick,
    initialGroupApplyTotalMs: initialGroupApplyTotal(sample),
    perActiveTickApply: distribution(applyRows.map((row) => row.totalApplyCostMs)),
  };
});

const pooledLeaderResponses = runs.flatMap((run) => initialLeaders(run.samples[0]!).map(responseMs));
const pooledRepathResponses = runs.flatMap((run) => individualRepaths(run.samples[0]!).map(responseMs));
const pooledApply = distribution(applyTickRows.map((row) => row.totalApplyCostMs));
const leaderResponseThresholdMs = 1000 / 30;
const approximateApplyThresholdMs = 2;
const result = {
  schema: "wayfinder-168-chrome-full-game-distribution-v1",
  generatedAt: new Date().toISOString(),
  browser: runs[0]!.browser,
  browserVersion: runs[0]!.browserVersion,
  userAgent: runs[0]!.userAgent,
  navigatorPlatform: runs[0]!.navigatorPlatform,
  hardwareConcurrency: runs[0]!.hardwareConcurrency,
  host: runs[0]!.host,
  config: runs[0]!.config,
  metricDefinitions: {
    percentile: "nearest rank; p95 is sorted[ceil(0.95*n)-1]",
    initialLeader: "request with commandTick === 1; eight per measured sample",
    individualRepath: "request without commandTick; generated by production movement",
    initialGroupApply: "sum of the eight production group/Activity callback costs at their shared apply tick",
    perActiveTickApply: "sum of all production apply callbacks at each committed apply tick; zero-apply ticks excluded",
  },
  thresholds: {
    leaderResponseMs: leaderResponseThresholdMs,
    approximateApplyPerTickMs: approximateApplyThresholdMs,
  },
  sampleCount: samples.length,
  samples,
  pooled: {
    initialLeaderResponse: distribution(pooledLeaderResponses),
    individualRepathResponse: distribution(pooledRepathResponses),
    perActiveTickApply: pooledApply,
  },
  thresholdObservations: {
    perSampleLeaderP95Exceeding33_3ms: samples.filter(
      (sample) => sample.initialLeaderResponse.p95Ms > leaderResponseThresholdMs,
    ).length,
    pooledLeaderP95Exceeds33_3ms: pooledLeaderResponses.length > 0
      && nearestRankForThreshold(pooledLeaderResponses) > leaderResponseThresholdMs,
    initialGroupApplyTotalsExceeding2ms: samples.filter(
      (sample) => sample.initialGroupApplyTotalMs > approximateApplyThresholdMs,
    ).length,
    pooledPerActiveTickApplyP95Exceeds2ms: pooledApply.p95Ms > approximateApplyThresholdMs,
    perSampleApplyP95Exceeding2ms: samples.filter(
      (sample) => sample.perActiveTickApply.p95Ms > approximateApplyThresholdMs,
    ).length,
  },
};

function nearestRankForThreshold(values: readonly number[]): number {
  return distribution(values).p95Ms;
}

await writeFile(path.join(RESULTS, "apply-ticks.json"), `${JSON.stringify({
  schema: "wayfinder-168-apply-ticks-v1",
  definition: "Production apply callbacks grouped by committed applyTick; ticks with no apply work are absent.",
  rows: applyTickRows,
}, null, 2)}\n`);
await writeFile(path.join(RESULTS, "distribution.json"), `${JSON.stringify(result, null, 2)}\n`);
console.log(JSON.stringify({
  output: path.join(RESULTS, "distribution.json"),
  samples: samples.map((sample) => ({
    sample: sample.sample,
    wallClockMs: sample.wallClockMs,
    leaderP95Ms: sample.initialLeaderResponse.p95Ms,
    initialApplyMs: sample.initialGroupApplyTotalMs,
    applyP95Ms: sample.perActiveTickApply.p95Ms,
    applyMaxMs: sample.perActiveTickApply.maxMs,
  })),
  pooled: result.pooled,
  thresholdObservations: result.thresholdObservations,
}, null, 2));
